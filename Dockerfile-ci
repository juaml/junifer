# syntax=docker/dockerfile:1

ARG DATA_VERSION
FROM ghcr.io/juaml/junifer-data:${DATA_VERSION} AS junifer_data_image

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 LC_ALL=C.UTF-8

LABEL org.opencontainers.image.source=https://github.com/juaml/junifer \
      org.opencontainers.image.description="Junifer CI container image" \
      org.opencontainers.image.licenses=AGPL-3.0-only \
      Author="Fede Raimondo" \
      Email="f.raimondo@fz-juelich.de" \
      GitHub="https://github.com/fraimondo" \
      BaseImage="ubuntu:24.04"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # Base / runner tooling
    ca-certificates curl wget git jq sudo unzip vim file \
    xz-utils bzip2 zstd \
    python3 python3-venv python-is-python3 \
    # ANTs runtime
    bc \
    # AFNI runtime (non-GUI subset of AFNI's Ubuntu 24 list)
    tcsh gsl-bin libgsl27 libglu1-mesa libglw1-mesa libxm4 libjpeg62 \
    libxmu6 libxpm4 libxi6 libxext6 libglib2.0-0t64 libgomp1 \
    netpbm xvfb xfonts-base python3-numpy python3-matplotlib r-base \
    # FSL runtime
    dc libquadmath0 \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 ships a default 'ubuntu' user (uid 1000); give that uid to our user
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd -m -u 1000 -s /bin/bash docker \
    && usermod -aG sudo docker \
    && echo '%sudo ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/nopasswd

# --- Heavy, rarely-changing neuroimaging tools ---

# ANTs
COPY --from=antsx/ants:latest /opt/ants /opt/ants
ENV PATH="/opt/ants/bin:$PATH" \
    LD_LIBRARY_PATH="/opt/ants/lib"

# AFNI — native Ubuntu 24.04 build
RUN mkdir -p /opt/afni \
    && curl -fsSL https://afni.nimh.nih.gov/pub/dist/tgz/linux_ubuntu_24_64.tgz \
       | tar -xz -C /opt/afni --strip-components=1
ENV PATH="/opt/afni:$PATH"

# FSL — clean conda package cache in the same layer
RUN curl -fsSL https://fsl.fmrib.ox.ac.uk/fsldownloads/fslconda/releases/fslinstaller.py -o /tmp/fslinstaller.py \
    && (python3 /tmp/fslinstaller.py -d /opt/fsl/ --skip_registration \
        || { cat /root/fsl_installation_*.log; exit 1; }) \
    && rm -rf /opt/fsl/pkgs /tmp/fslinstaller.py /root/fsl_installation_*.log \
    && find /opt/fsl -name '__pycache__' -prune -exec rm -rf {} + \
    && ls /opt/fsl/bin | head -50
ENV FSLDIR=/opt/fsl \
    FSLOUTPUTTYPE=NIFTI_GZ \
    PATH="/opt/fsl/share/fsl/bin:$PATH"

# --- Hosted tool cache for setup-python ---
ARG PYTHON_VERSIONS="3.10 3.11 3.12 3.13 3.14"
ARG UBUNTU_TAG=24.04
ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
RUN set -eux; \
    mkdir -p "$AGENT_TOOLSDIRECTORY"; \
    curl -fsSL https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json -o /tmp/manifest.json; \
    filter='[ .[] | select(.stable and (.version | startswith($v + "."))) | .files[] | select(.platform=="linux" and .platform_version==$os and .arch=="x64") ][0].download_url'; \
    for v in $PYTHON_VERSIONS; do \
      url=$(jq -r --arg v "$v" --arg os "$UBUNTU_TAG" "$filter" /tmp/manifest.json); \
      test "$url" != "null"; \
      tmp=$(mktemp -d); \
      curl -fsSL "$url" | tar -xz -C "$tmp"; \
      (cd "$tmp" && chmod +x ./setup.sh && ./setup.sh); \
      rm -rf "$tmp"; \
    done; \
    rm /tmp/manifest.json; \
    chown -R docker:docker "$AGENT_TOOLSDIRECTORY"

# --- GitHub Actions runner ---
ARG RUNNER_VERSION
LABEL RunnerVersion=${RUNNER_VERSION}
RUN mkdir -p /home/docker/actions-runner && cd /home/docker/actions-runner \
    && curl -fsSL -o runner.tar.gz \
       https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    && tar xzf runner.tar.gz && rm runner.tar.gz \
    && ./bin/installdependencies.sh \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R docker:docker /home/docker

COPY --chmod=755 scripts/start.sh /start.sh

# --- Test data (changes most often → last) ---
ARG DATA_VERSION
COPY --from=junifer_data_image --chown=docker:docker \
     /opt/junifer-data /home/docker/junifer_data/${DATA_VERSION}
RUN echo ${DATA_VERSION} > /home/docker/junifer-data-version

USER docker
WORKDIR /home/docker
ENTRYPOINT ["/start.sh"]